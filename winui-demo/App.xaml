<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="V4Wa.Demo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- V4Wa Dynamic Theme Engine Brushes (mutated live by ThemeEngine) -->
            <SolidColorBrush x:Key="V4WaAccentBrush" Color="#FF10B981" />
            <SolidColorBrush x:Key="V4WaAccentLightBrush" Color="#FF34D399" />
            <SolidColorBrush x:Key="V4WaAccentTextBrush" Color="#FFA7F3D0" />
            <SolidColorBrush x:Key="V4WaAccentBgBrush" Color="#2E10B981" />
            <SolidColorBrush x:Key="V4WaAccentBorderBrush" Color="#8C34D399" />

            <SolidColorBrush x:Key="V4WaCardBgBrush" Color="#CC121216" />
            <SolidColorBrush x:Key="V4WaCardBorderBrush" Color="#FF2E2E36" />
            <SolidColorBrush x:Key="V4WaSubtleBgBrush" Color="#CC0B0B0E" />
            <SolidColorBrush x:Key="V4WaHeaderBgBrush" Color="#AA09090B" />
            <SolidColorBrush x:Key="V4WaMutedBrush" Color="#FF71717A" />
            <SolidColorBrush x:Key="V4WaTextSecondaryBrush" Color="#FFA1A1AA" />

            <!-- Fluent Control Accent Overrides (also mutated live by ThemeEngine) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF10B981" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF34D399" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF059669" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF10B981" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF34D399" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF059669" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF34D399" />

            <!-- Card Border Style -->
            <Style x:Key="V4WaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource V4WaCardBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource V4WaCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
