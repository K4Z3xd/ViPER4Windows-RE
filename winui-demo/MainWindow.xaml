<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="V4Wa.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="V4Wa — Native WinUI 3 Demo">

    <Grid Background="#FF09090B">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Native Windows 11 Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource V4WaEmeraldLightBrush}" />
                <TextBlock Text="V4Wa" FontSize="12" FontWeight="SemiBold" Foreground="#FFF4F4F5" />
                <Border Background="#2410B981" BorderBrush="#5534D399" BorderThickness="1" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="WINUI 3 NATIVE DEMO" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF6EE7B7" CharacterSpacing="40" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Top Studio Header -->
        <Border Grid.Row="1" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Background="#AA09090B" Padding="24,12">
            <Grid MaxWidth="1140">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Logo + V4Wa + TeachingTip + Device Subtitle -->
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#FF141418" BorderBrush="#FF2E2E36" BorderThickness="1">
                        <FontIcon Glyph="&#xE9E9;" FontSize="19" Foreground="{StaticResource V4WaEmeraldLightBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="V4Wa" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <Button x:Name="V4WaInfoBtn" Style="{StaticResource InfoTipButtonStyle}" Click="V4WaInfoBtn_Click" ToolTipService.ToolTip="What does V4Wa mean?">
                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Headphones (CX31993+MAX97220 HiFiAudio) · 384.0 kHz / 32-bit · Full UI Preview"
                                   FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Nav Tabs + WORKING Pill + Master Power -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#FF141418" BorderBrush="#FF2E2E36" BorderThickness="1" CornerRadius="9" Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="TabDspBtn" Content="DSP Console" Click="TabDspBtn_Click"
                                    CornerRadius="6" Padding="12,5" FontSize="12" FontWeight="SemiBold"
                                    Background="#FF27272A" Foreground="White" BorderThickness="0" />
                            <Button x:Name="TabDevicesBtn" Content="Devices &amp; APO" Click="TabDevicesBtn_Click"
                                    CornerRadius="6" Padding="12,5" FontSize="12" FontWeight="Medium"
                                    Background="Transparent" Foreground="#FFA1A1AA" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- WORKING / NOT WORKING Status Pill -->
                    <Border x:Name="StatusPill" CornerRadius="8" BorderThickness="1" Padding="12,6"
                            Background="#2810B981" BorderBrush="#8034D399">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF34D399" />
                            <TextBlock x:Name="StatusText" Text="WORKING" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FFA7F3D0" />
                        </StackPanel>
                    </Border>

                    <!-- Master Power Toggle -->
                    <ToggleSwitch x:Name="MasterToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="MasterToggle_Toggled" ToolTipService.ToolTip="Master Engine Power" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TeachingTip explaining V4Wa -->
        <TeachingTip x:Name="V4WaTeachingTip"
                     Target="{x:Bind V4WaInfoBtn}"
                     Title="ViPER4Windows Alternative (V4Wa)"
                     Subtitle="Why the 'a'?"
                     PreferredPlacement="BottomLeft"
                     IsLightDismissEnabled="True">
            <TeachingTip.Content>
                <StackPanel Spacing="8" Margin="0,6,0,0" MaxWidth="330">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FFE4E4E7"
                               Text="'a' stands for Alternative — a modern, clean-room replacement for the legacy 2013 ViPER4Windows driver." />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FFA1A1AA"
                               Text="• Hi-Res Engine: Native Windows 10/11 MFX APO supporting 44.1–384 kHz with 64-bit internal DSP." />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FFA1A1AA"
                               Text="• Full Parity: Combines all 17 ViPER4Windows and ViPER4Android FX modules in one native Fluent app." />
                </StackPanel>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,20,24,36">
            <Grid MaxWidth="1140" HorizontalAlignment="Center" Width="1140">

                <!-- DSP CONSOLE TAB -->
                <StackPanel x:Name="DspConsolePanel" Spacing="18">

                    <!-- Live Signal Path Card (Dummy Telemetry) -->
                    <Border Style="{StaticResource V4WaCardStyle}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10" Background="#1F10B981" BorderBrush="#6634D399" BorderThickness="1">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#FF34D399" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="FOOBAR2000" FontSize="12.5" FontWeight="Bold" Foreground="#FFF4F4F5" CharacterSpacing="40" />
                                        <Border Background="#FF1C1C21" CornerRadius="5" Padding="7,2">
                                            <TextBlock Text="SHARED MODE" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFA1A1AA" />
                                        </Border>
                                        <Border Background="#FF18181D" CornerRadius="5" Padding="7,2">
                                            <TextBlock Text="+ Google Chrome" FontFamily="Consolas" FontSize="10.5" Foreground="#FF71717A" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Aimer — us  (Dummy Live Signal Path)" FontSize="12" Foreground="#FFA1A1AA" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="#2410B981" BorderBrush="#6634D399" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="HI-RES AUDIO" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#FF6EE7B7" />
                                </Border>
                                <Border Background="#FF0B0B0E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="FLAC" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                </Border>
                                <Border Background="#FF0B0B0E" BorderBrush="#5510B981" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="192.0 kHz" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF6EE7B7" />
                                </Border>
                                <Border Background="#FF0B0B0E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="24-bit" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                </Border>
                                <Border Background="#FF0B0B0E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="4,608 kbps" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFA1A1AA" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pinned Presets Strip (Dynamic) -->
                    <Grid x:Name="PinnedPresetsGrid" ColumnSpacing="12" />

                    <!-- Preset Manager Bar -->
                    <Border Style="{StaticResource V4WaCardStyle}" Padding="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" SelectionChanged="PresetCombo_SelectionChanged" SelectedIndex="1">
                                <ComboBoxItem Content="Flat Reference" />
                                <ComboBoxItem Content="Hi-Res Audiophile" />
                                <ComboBoxItem Content="Deep Bass Boost" />
                                <ComboBoxItem Content="Warm Tube Studio" />
                            </ComboBox>
                            <Button x:Name="PinPresetBtn" Grid.Column="1" Content="Pinned" Padding="14,6" CornerRadius="8"
                                    Click="PinPresetBtn_Click" FontWeight="SemiBold" />
                            <Button Grid.Column="2" Content="Save" Padding="14,6" CornerRadius="8" Click="DummyAction_Click" Tag="Full preset snapshot saved (dummy preview)" />
                            <Button Grid.Column="3" Content="Load" Padding="14,6" CornerRadius="8" Click="DummyAction_Click" Tag="Batch JSON preset loader opened (dummy preview)" />
                        </Grid>
                    </Border>

                    <!-- Hi-Res Equalizer Card (Live Interactive Curve + Vertical Sliders) -->
                    <Border Style="{StaticResource V4WaCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon x:Name="EqIcon" Glyph="&#xE9E9;" FontSize="16" Foreground="{StaticResource V4WaEmeraldLightBrush}" />
                                    <TextBlock x:Name="EqTitleText" Text="10-Band Hi-Res Equalizer" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                    <FontIcon Glyph="&#xE946;" FontSize="13.5" Foreground="#FF71717A"
                                              ToolTipService.ToolTip="64-bit Biquad parametric equalizer. Switch between 10-Band (1-octave) and 18-Band (1/2-octave) for surgical tonal shaping from 31 Hz up to 16 kHz." />
                                    <Border Background="#FF0B0B0E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="8" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="Eq10Btn" Content="10-Band" Padding="10,4" CornerRadius="6" FontFamily="Consolas" FontSize="11.5"
                                                    Click="EqModeBtn_Click" Tag="10" BorderThickness="0" />
                                            <Button x:Name="Eq18Btn" Content="18-Band" Padding="10,4" CornerRadius="6" FontFamily="Consolas" FontSize="11.5"
                                                    Click="EqModeBtn_Click" Tag="18" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="EqPresetCombo" Width="156" SelectionChanged="EqPresetCombo_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Custom" />
                                        <ComboBoxItem Content="Flat" />
                                        <ComboBoxItem Content="V-Shape Fun" />
                                        <ComboBoxItem Content="Vocal Focus" />
                                        <ComboBoxItem Content="Deep Basshead" />
                                        <ComboBoxItem Content="Acoustic &amp; Jazz" />
                                    </ComboBox>
                                    <Button Content="Save" Click="DummyAction_Click" Tag="EQ preset saved (dummy preview)" CornerRadius="8" Padding="10,5" FontSize="12" />
                                    <Button Content="Load" Click="DummyAction_Click" Tag="EQ preset loader opened (dummy preview)" CornerRadius="8" Padding="10,5" FontSize="12" />
                                    <Button Content="Reset EQ" Click="ResetEqBtn_Click" CornerRadius="8" Padding="10,5" FontSize="12" />
                                    <ToggleSwitch x:Name="EqToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0" Toggled="ModuleToggle_Toggled" />
                                </StackPanel>
                            </Grid>

                            <!-- Live Frequency Curve Canvas -->
                            <Border Background="#FF070709" BorderBrush="#FF27272A" BorderThickness="1" CornerRadius="10" Height="112" Padding="14,10">
                                <Canvas x:Name="EqCurveCanvas" SizeChanged="EqCurveCanvas_SizeChanged" />
                            </Border>

                            <!-- Dynamic Vertical Sliders Container -->
                            <Grid x:Name="EqSlidersGrid" />
                        </StackPanel>
                    </Border>

                    <!-- All 16 Remaining DSP Modules (Dynamic 2-Column Grid with Live Pin-to-Top) -->
                    <Grid x:Name="ModulesGrid" ColumnSpacing="16" RowSpacing="16" />
                </StackPanel>

                <!-- DEVICES & APO TAB (Full Windows 11 Settings-Style Preview) -->
                <StackPanel x:Name="DevicesPanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Native WinUI 3 Full UI Dummy Preview"
                             Message="All 17 DSP modules, presets, pinning, and Devices &amp; APO cards are interactive mockups. Your real live APO engine is untouched." />

                    <!-- Primary Hi-Res USB DAC Card -->
                    <Border Style="{StaticResource V4WaCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F6;" FontSize="16" Foreground="#FF34D399" />
                                        <TextBlock Text="Headphones (CX31993+MAX97220 HiFiAudio)" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                        <Border Background="#2410B981" BorderBrush="#6634D399" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                            <TextBlock Text="DEFAULT · MFX APO ACTIVE" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#FF6EE7B7" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Endpoint GUID: {d62a84b9-0a81-4d82-891d-d7a6ef88fb4d} · 384.0 kHz / 32-bit IEEE Float · 2ch"
                                               FontFamily="Consolas" FontSize="12" Foreground="#FFA1A1AA" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Install / Repair APO" Background="#2410B981" BorderBrush="#6634D399" Foreground="#FF6EE7B7"
                                            CornerRadius="8" Padding="14,7" FontWeight="SemiBold"
                                            Click="DummyAction_Click" Tag="APO Install script triggered (dummy preview)" />
                                    <Button Content="1-Click Restore Factory" CornerRadius="8" Padding="14,7"
                                            Click="DummyAction_Click" Tag="Factory Registry backup restore triggered (dummy preview)" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FF0B0B0E" BorderBrush="#FF2E2E36" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Install MFX APO (Run as Admin)" FontSize="12" FontWeight="SemiBold" Foreground="#FF6EE7B7" />
                                        <TextBlock Text="powershell -ExecutionPolicy Bypass -File scripts\install_apo.ps1 -EndpointGuid &quot;{d62a84b9-0a81-4d82-891d-d7a6ef88fb4d}&quot;"
                                                   FontFamily="Consolas" FontSize="11" Foreground="#FFD4D4D8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FF0B0B0E" BorderBrush="#FF2E2E36" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="1-Click Restore Factory Audio (Run as Admin)" FontSize="12" FontWeight="SemiBold" Foreground="#FF6EE7B7" />
                                        <TextBlock Text="powershell -ExecutionPolicy Bypass -File scripts\uninstall_apo.ps1 -EndpointGuid &quot;{d62a84b9-0a81-4d82-891d-d7a6ef88fb4d}&quot;"
                                                   FontFamily="Consolas" FontSize="11" Foreground="#FFD4D4D8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Secondary Endpoints (Dummy) -->
                    <Border Style="{StaticResource V4WaCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Other Audio Endpoints" FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                            <Grid Background="#FF0B0B0E" BorderBrush="#FF2E2E36" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Speakers (Realtek High Definition Audio)" FontSize="13.5" FontWeight="Medium" Foreground="#FFE4E4E7" />
                                    <TextBlock Text="48.0 kHz / 24-bit · 2ch · APO Not Installed" FontFamily="Consolas" FontSize="11.5" Foreground="#FF71717A" />
                                </StackPanel>
                                <Button Content="Attach APO" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Padding="12,5"
                                        Click="DummyAction_Click" Tag="Attach APO to Realtek Speakers (dummy preview)" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- foobar2000 Telemetry Plugin Status -->
                    <Border Style="{StaticResource V4WaCardStyle}">
                        <Grid>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="#FF34D399" />
                                    <TextBlock Text="foobar2000 v2.x Status Reporter" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <Border Background="#2410B981" BorderBrush="#6634D399" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                        <TextBlock Text="BIT-TRANSPARENT · v0.4.1" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#FF6EE7B7" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Pure zero-modification telemetry bridge reporting FLAC / Hi-Res / Shared vs Exclusive mode in real time."
                                           FontSize="12.5" Foreground="#FFA1A1AA" />
                            </StackPanel>
                            <Button Content="Check Status" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="14,6"
                                    Click="DummyAction_Click" Tag="foobar2000 Status Reporter connected (dummy preview)" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Subtle Toast InfoBar for Dummy Actions -->
        <InfoBar x:Name="ToastBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 Margin="24" IsOpen="False" Severity="Success" />
    </Grid>
</Window>
