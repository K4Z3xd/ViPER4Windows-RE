<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="V4Wa.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="V4Wa">

    <Grid x:Name="RootBackdropGrid" Background="Transparent" SizeChanged="RootBackdropGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Title Bar (V4Wa text only) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,140,0" Background="Transparent">
            <TextBlock Text="V4Wa" FontSize="12" FontWeight="SemiBold" Foreground="#B3F4F4F5" VerticalAlignment="Center" />
        </Grid>

        <!-- Top Studio Header (2-col Grid prevents overlap) -->
        <Border x:Name="TopHeaderBorder" Grid.Row="1" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource V4WaHeaderBgBrush}" Padding="20,10">
            <Grid MaxWidth="1280" HorizontalAlignment="Stretch" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left (DSP Mode): Speaker Icon Box + Truncating Audio Output Info -->
                <Grid x:Name="HeaderAudioInfoPanel" Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SpeakerBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                            Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                        <FontIcon x:Name="HeaderSpeakerIcon" Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource V4WaAccentLightBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="HeaderDeviceNameText" Text="Loading audio device..." FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeaderDeviceFormatText" Text="Windows 11 Hi-Res MFX APO"
                                   FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Left (Settings Mode): Back Arrow + Settings Title -->
                <StackPanel x:Name="HeaderSettingsPanel" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Click="BackToDspBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4"
                            Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Back to DSP">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="White" />
                    </Button>
                    <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Settings Gear Button + WORKING Pill + Master Power -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Click="SettingsBtn_Click"
                            Width="34" Height="34" Padding="0" CornerRadius="4"
                            Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Settings">
                        <FontIcon x:Name="SettingsGearIcon" Glyph="&#xE713;" FontSize="15" Foreground="#FFE4E4E7" />
                    </Button>

                    <Border x:Name="StatusPill" Height="34" CornerRadius="4" BorderThickness="1" Padding="12,0"
                            Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource V4WaAccentLightBrush}" />
                            <TextBlock x:Name="StatusText" Text="WORKING" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" />
                        </StackPanel>
                    </Border>

                    <ToggleSwitch x:Name="MasterToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="MasterToggle_Toggled" ToolTipService.ToolTip="Master Engine Power" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DSP CONSOLE VIEW (Fully Responsive) -->
        <ScrollViewer x:Name="DspScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16,20,32">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch" Spacing="14">

                <!-- Live Signal Path Card (Wraps badges to Row 1 when narrow) -->
                <Border x:Name="SignalPathCard" Style="{StaticResource V4WaCardStyle}" Padding="16,12">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SignalBadgesCol" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6"
                                    Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="SignalSourceText" Text="WINDOWS AUDIO APO" FontSize="12.5" FontWeight="Bold" Foreground="#FFF4F4F5" CharacterSpacing="40" />
                                    <Border x:Name="SignalModeBadge" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="SignalModeText" Text="STANDBY" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFD4D4D8" />
                                    </Border>
                                    <Border x:Name="SignalExtraAppsBadge" Visibility="Collapsed" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="SignalExtraAppsText" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="#FFA1A1AA" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SignalTitleText" Text="Waiting for audio stream..." FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SignalBadgesPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border x:Name="SignalHiResBadge" Visibility="Collapsed" Height="28" Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                <TextBlock Text="HI-RES AUDIO" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SignalCodecBadge" Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                <TextBlock x:Name="SignalCodecText" Text="32-BIT FLOAT" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                <TextBlock x:Name="SignalSampleRateText" Text="48.0 kHz" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource V4WaAccentLightBrush}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SignalBitDepthBadge" Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                <TextBlock x:Name="SignalBitDepthText" Text="32-bit" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SignalBitrateBadge" Visibility="Collapsed" Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                <TextBlock x:Name="SignalBitrateText" Text="" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFB4B4BE" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pinned Presets Strip (Responsive 4 / 2 / 1 cols) -->
                <Grid x:Name="PinnedPresetsGrid" ColumnSpacing="10" RowSpacing="10" />

                <!-- Preset Manager Bar (Wraps buttons to Row 1 when narrow) -->
                <Border x:Name="PresetBarCard" Style="{StaticResource V4WaCardStyle}" Padding="10">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PresetActionsCol" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="PresetCombo" Grid.Row="0" Grid.Column="0" Style="{StaticResource V4WaToolbarComboStyle}" HorizontalAlignment="Stretch" SelectionChanged="PresetCombo_SelectionChanged" SelectedIndex="1">
                            <ComboBoxItem Content="Flat Reference" />
                            <ComboBoxItem Content="Hi-Res Audiophile" />
                            <ComboBoxItem Content="Deep Bass Boost" />
                            <ComboBoxItem Content="Warm Tube Studio" />
                        </ComboBox>

                        <StackPanel x:Name="PresetActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PinPresetBtn" Content="Pinned" Style="{StaticResource V4WaToolbarButtonStyle}"
                                    Click="PinPresetBtn_Click" FontWeight="SemiBold" />
                            <Button Content="Save" Style="{StaticResource V4WaToolbarButtonStyle}" Click="SavePresetBtn_Click" />
                            <Button Content="Load" Style="{StaticResource V4WaToolbarButtonStyle}" Click="LoadPresetBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Equalizer Card (Wraps right toolbar to Row 1 when narrow) -->
                <Border x:Name="EqCard" Style="{StaticResource V4WaCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="EqActionsCol" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border x:Name="EqIconBox" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                                    <FontIcon x:Name="EqIcon" Glyph="&#xE9E9;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                                </Border>
                                <TextBlock x:Name="EqTitleText" Text="Equalizer" FontSize="15.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE946;" FontSize="13.5" Foreground="{StaticResource V4WaMutedBrush}" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="64-bit Biquad parametric equalizer. Switch between 10-Band (1-octave) and 18-Band (1/2-octave) for surgical tonal shaping from 31 Hz up to 16 kHz." />
                                <Border Height="34" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="Eq10Btn" Content="10-Band" Height="28" Padding="10,0" CornerRadius="3" FontFamily="Consolas" FontSize="11.5"
                                                Click="EqModeBtn_Click" Tag="10" BorderThickness="0" />
                                        <Button x:Name="Eq18Btn" Content="18-Band" Height="28" Padding="10,0" CornerRadius="3" FontFamily="Consolas" FontSize="11.5"
                                                Click="EqModeBtn_Click" Tag="18" BorderThickness="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="EqActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox x:Name="EqPresetCombo" Style="{StaticResource V4WaToolbarComboStyle}" Width="140" SelectionChanged="EqPresetCombo_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Custom" />
                                    <ComboBoxItem Content="Flat" />
                                    <ComboBoxItem Content="V-Shape Fun" />
                                    <ComboBoxItem Content="Vocal Focus" />
                                    <ComboBoxItem Content="Deep Basshead" />
                                    <ComboBoxItem Content="Acoustic &amp; Jazz" />
                                </ComboBox>
                                <Button Content="Save" Style="{StaticResource V4WaToolbarButtonStyle}" Click="SaveEqPresetBtn_Click" />
                                <Button Content="Load" Style="{StaticResource V4WaToolbarButtonStyle}" Click="LoadEqPresetBtn_Click" />
                                <Button Content="Reset" Style="{StaticResource V4WaToolbarButtonStyle}" Click="ResetEqBtn_Click" />
                                <ToggleSwitch x:Name="EqToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0" Toggled="ModuleToggle_Toggled" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="110" Padding="14,10">
                            <Canvas x:Name="EqCurveCanvas" SizeChanged="EqCurveCanvas_SizeChanged" />
                        </Border>

                        <Grid x:Name="EqSlidersGrid" />
                    </StackPanel>
                </Border>

                <!-- All 16 Remaining DSP Modules (Responsive 2-col / 1-col) -->
                <Grid x:Name="ModulesGrid" ColumnSpacing="14" RowSpacing="14" />
            </StackPanel>
        </ScrollViewer>

        <!-- SETTINGS VIEW (Responsive Sidebar collapses to compact Icon-Only Rail on narrow screens) -->
        <Grid x:Name="SettingsSplitGrid" Grid.Row="2" Visibility="Collapsed" MaxWidth="1280" HorizontalAlignment="Stretch" Padding="16,14,16,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsSidebarCol" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Category Sidebar (auto-collapses to icon-only rail when width < 760px) -->
            <StackPanel x:Name="SettingsSidebarPanel" Grid.Column="0" Spacing="4" Margin="0,4,14,0">
                <Button x:Name="NavAppearanceBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="Appearance"
                        ToolTipService.ToolTip="Appearance">
                    <Grid>
                        <Border x:Name="NavAppearancePill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,10,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAppearanceIcon" Glyph="&#xE790;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                            <TextBlock x:Name="NavAppearanceLabel" Text="Appearance" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="NavDevicesBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="Devices"
                        ToolTipService.ToolTip="Devices &amp; APO">
                    <Grid>
                        <Border x:Name="NavDevicesPill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,10,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavDevicesIcon" Glyph="&#xE7F6;" FontSize="15" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                            <TextBlock x:Name="NavDevicesLabel" Text="Devices &amp; APO" FontSize="13.5" FontWeight="Medium" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="NavAboutBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="About"
                        ToolTipService.ToolTip="About">
                    <Grid>
                        <Border x:Name="NavAboutPill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,10,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAboutIcon" Glyph="&#xE946;" FontSize="15" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                            <TextBlock x:Name="NavAboutLabel" Text="About" FontSize="13.5" FontWeight="Medium" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Right Settings Content Area (extra right padding so scrollbar never overlaps card border) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,0,14,20">
                <Grid>
                    <!-- PAGE 1: APPEARANCE -->
                    <StackPanel x:Name="SettingsAppearancePage" Spacing="14">
                        <TextBlock Text="Appearance" FontSize="22" FontWeight="Bold" Foreground="White" Margin="2,0,0,4" />

                        <Border x:Name="AppearanceThemeCard" Style="{StaticResource V4WaCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Theme" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Choose between native Windows 11 Acrylic translucency or pure Dark OLED black."
                                               FontSize="12.5" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ThemeOledCol" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="ThemeAcrylicBtn" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,12" CornerRadius="6" BorderThickness="1" Click="ThemePresetBtn_Click" Tag="Acrylic">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Acrylic" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Default translucent glass backdrop with high contrast" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="ThemeOledBtn" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,12" CornerRadius="6" BorderThickness="1" Click="ThemePresetBtn_Click" Tag="DarkOLED">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Dark OLED" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Pure OLED pitch black with crisp studio borders" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Accent Color Card -->
                        <Border x:Name="AppearanceAccentCard" Style="{StaticResource V4WaCardStyle}">
                            <Grid x:Name="AccentLayoutGrid" ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AccentPickerCol" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16">
                                    <!-- Proper 2-column Grid so text NEVER overlaps ToggleSwitch! -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Auto Sync Windows Accent Color" FontSize="14.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                            <TextBlock Text="Automatically match your Windows 11 Personalization accent color." FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoAccentToggle" Grid.Column="1" VerticalAlignment="Center" IsOn="False" OnContent="" OffContent="" MinWidth="0"
                                                      Toggled="AutoAccentToggle_Toggled" />
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Quick Accent Swatches" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FF10B981" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#10B981" ToolTipService.ToolTip="V4Wa Emerald (#10B981)" />
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FF0A84FF" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#0A84FF" ToolTipService.ToolTip="Apple Blue (#0A84FF)" />
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FF8B5CF6" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#8B5CF6" ToolTipService.ToolTip="Studio Violet (#8B5CF6)" />
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FFF43F5E" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#F43F5E" ToolTipService.ToolTip="Crimson Rose (#F43F5E)" />
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FFF59E0B" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#F59E0B" ToolTipService.ToolTip="Warm Amber (#F59E0B)" />
                                            <Button Width="32" Height="32" CornerRadius="6" Background="#FF06B6D4" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#06B6D4" ToolTipService.ToolTip="Hi-Res Cyan (#06B6D4)" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{StaticResource V4WaAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="Active Accent Color" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                                                <TextBlock x:Name="ActiveAccentHexText" Text="#10B981 · RGB(16, 185, 129)" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Native WinUI 3 RGB Color Picker wrapped in DownOnly Viewbox so it never overflows! -->
                                <StackPanel x:Name="AccentPickerPanel" Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Custom RGB Color Picker" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <ColorPicker x:Name="AccentColorPicker"
                                                     Color="#FF10B981"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="True"
                                                     IsColorChannelTextInputVisible="True"
                                                     IsHexInputVisible="True"
                                                     IsAlphaEnabled="False"
                                                     ColorChanged="AccentColorPicker_ColorChanged" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 2: DEVICES & APO (Live Core Audio Endpoints + 1-Click Elevated Install/Restore) -->
                    <StackPanel x:Name="SettingsDevicesPage" Spacing="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Devices &amp; APO" FontSize="22" FontWeight="Bold" Foreground="White" Margin="2,0,0,4" />
                            <Button Grid.Column="1" Content="Refresh Devices" Style="{StaticResource V4WaToolbarButtonStyle}" Click="RefreshDevicesBtn_Click" />
                        </Grid>

                        <StackPanel x:Name="DevicesListPanel" Spacing="12" />

                        <!-- foobar2000 Status Reporter Card -->
                        <Border Style="{StaticResource V4WaCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="foobar2000 v2.x Status Reporter" FontSize="14.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                    <Border HorizontalAlignment="Left" Height="22" Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,0">
                                        <TextBlock x:Name="FoobarPluginStatusText" Text="CHECKING..." FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Pure bit-transparent telemetry bridge reporting FLAC / Hi-Res / Shared vs Exclusive mode in real time."
                                               FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 3: ABOUT -->
                    <StackPanel x:Name="SettingsAboutPage" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="About" FontSize="22" FontWeight="Bold" Foreground="White" Margin="2,0,0,4" />

                        <Border x:Name="AboutCard" Style="{StaticResource V4WaCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="V4Wa — ViPER4Windows Alternative" FontSize="17" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FFE4E4E7"
                                           Text="'a' stands for Alternative — a clean-room modern Windows 10/11 Hi-Res MFX Audio Processing Object (44.1–384 kHz, 64-bit internal DSP) uniting full ViPER4Windows and ViPER4Android FX sound modules in one native WinUI 3 app." />
                                <TextBlock Text="Engine: C++23 Real-Time DSP · 17 Modules · Zero-Allocation Audio Thread · Seqlock IPC"
                                           FontFamily="Consolas" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Subtle Toast InfoBar -->
        <InfoBar x:Name="ToastBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 Margin="20" IsOpen="False" Severity="Success" />
    </Grid>
</Window>
