<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="V4Wa.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="V4Wa">

    <Grid x:Name="RootBackdropGrid" Background="Transparent" SizeChanged="RootBackdropGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Title Bar (V4Wa text only) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,140,0" Background="Transparent">
            <TextBlock Text="V4Wa" FontSize="12" FontWeight="SemiBold" Foreground="#B3F4F4F5" VerticalAlignment="Center" />
        </Grid>

        <!-- Top Studio Header -->
        <Border x:Name="TopHeaderBorder" Grid.Row="1" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource V4WaHeaderBgBrush}" Padding="20,10">
            <Grid MaxWidth="1280" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left (DSP Mode): Speaker Icon Box + Audio Output Info -->
                <StackPanel x:Name="HeaderAudioInfoPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border x:Name="SpeakerBadge" Width="38" Height="38" CornerRadius="6"
                            Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                        <FontIcon x:Name="HeaderSpeakerIcon" Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource V4WaAccentLightBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Headphones (CX31993+MAX97220 HiFiAudio)" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="384.0 kHz · 32-bit IEEE Float · Stereo Output"
                                   FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Left (Settings Mode): Back Arrow + Settings Title -->
                <StackPanel x:Name="HeaderSettingsPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Click="BackToDspBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4"
                            Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Back to DSP">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="White" />
                    </Button>
                    <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Settings Gear Button + WORKING Pill + Master Power -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Click="SettingsBtn_Click"
                            Width="34" Height="34" Padding="0" CornerRadius="4"
                            Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Settings">
                        <FontIcon x:Name="SettingsGearIcon" Glyph="&#xE713;" FontSize="15" Foreground="#FFE4E4E7" />
                    </Button>

                    <!-- WORKING / NOT WORKING Status Pill (matched 34px height) -->
                    <Border x:Name="StatusPill" Height="34" CornerRadius="4" BorderThickness="1" Padding="12,0"
                            Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource V4WaAccentLightBrush}" />
                            <TextBlock x:Name="StatusText" Text="WORKING" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Master Power Toggle -->
                    <ToggleSwitch x:Name="MasterToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="MasterToggle_Toggled" ToolTipService.ToolTip="Master Engine Power" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DSP CONSOLE VIEW (Responsive Width) -->
        <ScrollViewer x:Name="DspScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16,20,32">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch" Spacing="14">

                <!-- Live Signal Path Card -->
                <Border x:Name="SignalPathCard" Style="{StaticResource V4WaCardStyle}" Padding="16,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="6"
                                    Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="FOOBAR2000" FontSize="12.5" FontWeight="Bold" Foreground="#FFF4F4F5" CharacterSpacing="40" />
                                    <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                        <TextBlock Text="SHARED MODE" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFD4D4D8" />
                                    </Border>
                                    <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                        <TextBlock Text="+ Google Chrome" FontFamily="Consolas" FontSize="10.5" Foreground="#FFA1A1AA" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Aimer — us" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Height="28" Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,0">
                                <TextBlock Text="HI-RES AUDIO" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,0">
                                <TextBlock Text="FLAC" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,0">
                                <TextBlock Text="192.0 kHz" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource V4WaAccentLightBrush}" VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,0">
                                <TextBlock Text="24-bit" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,0">
                                <TextBlock Text="4,608 kbps" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#FFB4B4BE" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pinned Presets Strip (Responsive 4 / 2 / 1 cols) -->
                <Grid x:Name="PinnedPresetsGrid" ColumnSpacing="10" RowSpacing="10" />

                <!-- Preset Manager Bar (Uniform 34px Controls) -->
                <Border x:Name="PresetBarCard" Style="{StaticResource V4WaCardStyle}" Padding="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="PresetCombo" Style="{StaticResource V4WaToolbarComboStyle}" HorizontalAlignment="Stretch" SelectionChanged="PresetCombo_SelectionChanged" SelectedIndex="1">
                            <ComboBoxItem Content="Flat Reference" />
                            <ComboBoxItem Content="Hi-Res Audiophile" />
                            <ComboBoxItem Content="Deep Bass Boost" />
                            <ComboBoxItem Content="Warm Tube Studio" />
                        </ComboBox>
                        <Button x:Name="PinPresetBtn" Grid.Column="1" Content="Pinned" Style="{StaticResource V4WaToolbarButtonStyle}"
                                Click="PinPresetBtn_Click" FontWeight="SemiBold" />
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource V4WaToolbarButtonStyle}" Click="DummyAction_Click" Tag="Full preset snapshot saved (dummy preview)" />
                        <Button Grid.Column="3" Content="Load" Style="{StaticResource V4WaToolbarButtonStyle}" Click="DummyAction_Click" Tag="Batch JSON preset loader opened (dummy preview)" />
                    </Grid>
                </Border>

                <!-- Equalizer Card (Clean title + Icon Box + Uniform 34px Controls) -->
                <Border x:Name="EqCard" Style="{StaticResource V4WaCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border x:Name="EqIconBox" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1">
                                    <FontIcon x:Name="EqIcon" Glyph="&#xE9E9;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                                </Border>
                                <TextBlock x:Name="EqTitleText" Text="Equalizer" FontSize="15.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE946;" FontSize="13.5" Foreground="{StaticResource V4WaMutedBrush}" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="64-bit Biquad parametric equalizer. Switch between 10-Band (1-octave) and 18-Band (1/2-octave) for surgical tonal shaping from 31 Hz up to 16 kHz." />
                                <Border Height="34" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="Eq10Btn" Content="10-Band" Height="28" Padding="10,0" CornerRadius="3" FontFamily="Consolas" FontSize="11.5"
                                                Click="EqModeBtn_Click" Tag="10" BorderThickness="0" />
                                        <Button x:Name="Eq18Btn" Content="18-Band" Height="28" Padding="10,0" CornerRadius="3" FontFamily="Consolas" FontSize="11.5"
                                                Click="EqModeBtn_Click" Tag="18" BorderThickness="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox x:Name="EqPresetCombo" Style="{StaticResource V4WaToolbarComboStyle}" Width="154" SelectionChanged="EqPresetCombo_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Custom" />
                                    <ComboBoxItem Content="Flat" />
                                    <ComboBoxItem Content="V-Shape Fun" />
                                    <ComboBoxItem Content="Vocal Focus" />
                                    <ComboBoxItem Content="Deep Basshead" />
                                    <ComboBoxItem Content="Acoustic &amp; Jazz" />
                                </ComboBox>
                                <Button Content="Save" Style="{StaticResource V4WaToolbarButtonStyle}" Click="DummyAction_Click" Tag="EQ preset saved (dummy preview)" />
                                <Button Content="Load" Style="{StaticResource V4WaToolbarButtonStyle}" Click="DummyAction_Click" Tag="EQ preset loader opened (dummy preview)" />
                                <Button Content="Reset EQ" Style="{StaticResource V4WaToolbarButtonStyle}" Click="ResetEqBtn_Click" />
                                <ToggleSwitch x:Name="EqToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0" Toggled="ModuleToggle_Toggled" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="110" Padding="14,10">
                            <Canvas x:Name="EqCurveCanvas" SizeChanged="EqCurveCanvas_SizeChanged" />
                        </Border>

                        <Grid x:Name="EqSlidersGrid" />
                    </StackPanel>
                </Border>

                <!-- All 16 Remaining DSP Modules (Responsive 2-col / 1-col) -->
                <Grid x:Name="ModulesGrid" ColumnSpacing="14" RowSpacing="14" />
            </StackPanel>
        </ScrollViewer>

        <!-- SETTINGS VIEW (Responsive Windows 11 Settings Layout) -->
        <Grid x:Name="SettingsSplitGrid" Grid.Row="2" Visibility="Collapsed" MaxWidth="1280" HorizontalAlignment="Stretch" Padding="20,16,20,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsSidebarCol" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Category Sidebar -->
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,4,18,0">
                <Button x:Name="NavAppearanceBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="Appearance">
                    <Grid>
                        <Border x:Name="NavAppearancePill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,12,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAppearanceIcon" Glyph="&#xE790;" FontSize="15" Foreground="{StaticResource V4WaAccentLightBrush}" />
                            <TextBlock Text="Appearance" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="NavDevicesBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="Devices">
                    <Grid>
                        <Border x:Name="NavDevicesPill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,12,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavDevicesIcon" Glyph="&#xE7F6;" FontSize="15" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                            <TextBlock Text="Devices &amp; APO" FontSize="13.5" FontWeight="Medium" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="NavAboutBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Height="40" CornerRadius="4" BorderThickness="0" Click="SettingsNav_Click" Tag="About">
                    <Grid>
                        <Border x:Name="NavAboutPill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource V4WaAccentLightBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,12,0" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAboutIcon" Glyph="&#xE946;" FontSize="15" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                            <TextBlock Text="About" FontSize="13.5" FontWeight="Medium" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Right Settings Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,0,4,20">
                <Grid>
                    <!-- PAGE 1: APPEARANCE -->
                    <StackPanel x:Name="SettingsAppearancePage" Spacing="14">
                        <TextBlock Text="Appearance" FontSize="22" FontWeight="Bold" Foreground="White" Margin="2,0,0,4" />

                        <Border x:Name="AppearanceThemeCard" Style="{StaticResource V4WaCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Theme" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Choose between native Windows 11 Acrylic translucency or pure Dark OLED black."
                                               FontSize="12.5" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ThemeAcrylicBtn" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,12" CornerRadius="6" BorderThickness="1" Click="ThemePresetBtn_Click" Tag="Acrylic">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Acrylic" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Default translucent glass backdrop with high contrast" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="ThemeOledBtn" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,12" CornerRadius="6" BorderThickness="1" Click="ThemePresetBtn_Click" Tag="DarkOLED">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Dark OLED" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Pure OLED pitch black with crisp studio borders" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Accent Color Card -->
                        <Border x:Name="AppearanceAccentCard" Style="{StaticResource V4WaCardStyle}">
                            <Grid x:Name="AccentLayoutGrid" ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AccentPickerCol" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Auto Sync Windows Accent Color" FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Automatically match your Windows 11 Personalization accent color." FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoAccentToggle" HorizontalAlignment="Right" IsOn="False" OnContent="" OffContent="" MinWidth="0"
                                                      Toggled="AutoAccentToggle_Toggled" />
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Quick Accent Swatches" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FF10B981" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#10B981" ToolTipService.ToolTip="V4Wa Emerald (#10B981)" />
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FF0A84FF" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#0A84FF" ToolTipService.ToolTip="Apple Blue (#0A84FF)" />
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FF8B5CF6" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#8B5CF6" ToolTipService.ToolTip="Studio Violet (#8B5CF6)" />
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FFF43F5E" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#F43F5E" ToolTipService.ToolTip="Crimson Rose (#F43F5E)" />
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FFF59E0B" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#F59E0B" ToolTipService.ToolTip="Warm Amber (#F59E0B)" />
                                            <Button Width="34" Height="34" CornerRadius="6" Background="#FF06B6D4" BorderBrush="#90FFFFFF" BorderThickness="1"
                                                    Click="Swatch_Click" Tag="#06B6D4" ToolTipService.ToolTip="Hi-Res Cyan (#06B6D4)" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource V4WaAccentBrush}" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Active Accent Color" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" />
                                                <TextBlock x:Name="ActiveAccentHexText" Text="#10B981 · RGB(16, 185, 129)" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Native WinUI 3 RGB Color Picker -->
                                <StackPanel x:Name="AccentPickerPanel" Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Custom RGB Color Picker" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE4E4E7" />
                                    <ColorPicker x:Name="AccentColorPicker"
                                                 Color="#FF10B981"
                                                 ColorSpectrumShape="Box"
                                                 IsMoreButtonVisible="False"
                                                 IsColorSliderVisible="True"
                                                 IsColorChannelTextInputVisible="True"
                                                 IsHexInputVisible="True"
                                                 IsAlphaEnabled="False"
                                                 ColorChanged="AccentColorPicker_ColorChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 2: DEVICES & APO -->
                    <StackPanel x:Name="SettingsDevicesPage" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Devices &amp; APO" FontSize="22" FontWeight="Bold" Foreground="White" Margin="2,0,0,4" />

                        <Border x:Name="DevicesApoCard" Style="{StaticResource V4WaCardStyle}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Headphones (CX31993+MAX97220 HiFiAudio)" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <Border Height="22" Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                                <TextBlock Text="DEFAULT · MFX APO ACTIVE" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource V4WaAccentTextBrush}" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Endpoint GUID: {d62a84b9-0a81-4d82-891d-d7a6ef88fb4d} · 384.0 kHz / 32-bit IEEE Float · 2ch"
                                                   FontFamily="Consolas" FontSize="12" Foreground="{StaticResource V4WaTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Install / Repair APO" Style="{StaticResource V4WaToolbarButtonStyle}"
                                                Background="{StaticResource V4WaAccentBgBrush}" BorderBrush="{StaticResource V4WaAccentBorderBrush}"
                                                Foreground="{StaticResource V4WaAccentTextBrush}" FontWeight="SemiBold"
                                                Click="DummyAction_Click" Tag="APO Install script triggered (dummy preview)" />
                                        <Button Content="1-Click Restore Factory" Style="{StaticResource V4WaToolbarButtonStyle}"
                                                Click="DummyAction_Click" Tag="Factory Registry backup restore triggered (dummy preview)" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Install MFX APO (Run as Admin)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource V4WaAccentLightBrush}" />
                                            <TextBlock Text="powershell -ExecutionPolicy Bypass -File scripts\install_apo.ps1 -EndpointGuid &quot;{d62a84b9-0a81-4d82-891d-d7a6ef88fb4d}&quot;"
                                                       FontFamily="Consolas" FontSize="11" Foreground="#FFE4E4E7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource V4WaSubtleBgBrush}" BorderBrush="{StaticResource V4WaCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="1-Click Restore Factory Audio (Run as Admin)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource V4WaAccentLightBrush}" />
