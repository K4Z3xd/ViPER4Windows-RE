<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ViPER4WindowsRE.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows 11 Fluent Corner Radius & Typography Tokens -->
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>

            <!-- Dynamic Theme Brushes (mutated live by Appearance Engine) -->
            <SolidColorBrush x:Key="V4WaAccentBrush" Color="#FF10B981" />
            <SolidColorBrush x:Key="V4WaAccentLightBrush" Color="#FF34D399" />
            <SolidColorBrush x:Key="V4WaAccentTextBrush" Color="#FFA7F3D0" />
            <SolidColorBrush x:Key="V4WaAccentBgBrush" Color="#3310B981" />
            <SolidColorBrush x:Key="V4WaAccentBorderBrush" Color="#A034D399" />

            <!-- High-contrast continuous Acrylic surface brushes -->
            <SolidColorBrush x:Key="V4WaCardBgBrush" Color="#BA181A21" />
            <SolidColorBrush x:Key="V4WaCardBorderBrush" Color="#60FFFFFF" />
            <SolidColorBrush x:Key="V4WaSubtleBgBrush" Color="#B00E1016" />
            <SolidColorBrush x:Key="V4WaHeaderBgBrush" Color="#AA101218" />
            <SolidColorBrush x:Key="V4WaMutedBrush" Color="#FF8A8A96" />
            <SolidColorBrush x:Key="V4WaTextSecondaryBrush" Color="#FFB4B4BE" />

            <!-- Fluent Control Accent Overrides (mutated live) -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF10B981" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF34D399" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF059669" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF34D399" />

            <!-- Windows 11 Fluent Card Style (8px corners, crisp 2px continuous border) -->
            <Style x:Key="V4WaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource V4WaCardBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource V4WaCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <!-- Unified Toolbar Button Style (34px height, 4px Windows 11 corners, Segoe UI) -->
            <Style x:Key="V4WaToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource V4WaSubtleBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource V4WaCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Unified Toolbar ComboBox Style (34px height, 4px Windows 11 corners, Segoe UI) -->
            <Style x:Key="V4WaToolbarComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource V4WaSubtleBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource V4WaCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
