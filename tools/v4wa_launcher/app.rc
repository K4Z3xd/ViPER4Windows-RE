#include <winver.h>

1 ICON "..\\..\\app\\Assets\\app.ico"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ViPER4Windows RE"
            VALUE "FileDescription",  "ViPER4Windows RE Audio Console"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "ViPER4WindowsRE"
            VALUE "OriginalFilename", "ViPER4WindowsRE.exe"
            VALUE "ProductName",      "ViPER4Windows RE"
            VALUE "ProductVersion",   "1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
